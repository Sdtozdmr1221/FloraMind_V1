@model IEnumerable<FloraMind_V1.Models.Plant>
@{
    ViewData["Title"] = "Bitki Kataloğu";
}

<link rel="stylesheet" href="~/css/ShowCatalog.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<h2 class="page-title">Bitki Kataloğu</h2>
<div class="container mb-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-controller="Catalog" asp-action="ShowCatalog" method="get">
                <div class="input-group">
                    <input type="text"
                           name="searchString"
                           value="@ViewData["CurrentFilter"]"
                           class="form-control"
                           placeholder="Bitki türü ara... (Örn: Kaktüs, Sarmaşık)"
                           style="border-radius: 20px 0 0 20px; border: 2px solid #4CAF50;">

                    <button type="submit" class="btn btn-success" style="border-radius: 0 20px 20px 0;">
                        <i class="fas fa-search"></i> ARA
                    </button>
                </div>

                @if (ViewData["CurrentFilter"] != null)
                {
                    <div class="text-center mt-2">
                        <a asp-action="ShowCatalog" class="text-muted" style="text-decoration: underline;">Filtreyi Temizle / Tümünü Göster</a>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

<div class="card-container">
    @foreach (var item in Model)
    {
        <div class="plant-card">
            <div class="image-wrapper">
                <img src="~/images/@item.ImageUrl" alt="@item.Name">
            </div>
            
            <div class="card-body">
                <div class="card-main-info">
                    <h3>@item.Name</h3>
                    <ul>
                        <li><strong>Tür:</strong> @item.Species</li>
                    </ul>
                </div>

                <button class="info-btn" type="button">
                    <i class="fas fa-info"></i>
                </button>
            </div>

            <div class="card-info">
                <div class="card-info-content">
                    <form asp-controller="UserPlants" asp-action="Add" method="post">
                        <input type="hidden" name="plantId" value="@item.PlantID" />

                        <div class="card-buttons">
                            <a asp-controller="Catalog"
                               asp-action="Details"
                               asp-route-id="@item.PlantID"
                               class="info-btn2"
                               style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
                                BİLGİ
                            </a>

                            <button type="submit" class="save-btn">BİTKİLERİME KAYDET</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<script>
    document.querySelectorAll('.info-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const card = this.closest('.plant-card');
            card.classList.toggle('active');
        });
    });
</script>